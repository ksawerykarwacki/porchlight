#!/bin/bash
# Stand-in for the `claude` CLI in tests. Records how it was called and replays fixtures.
#
#   FAKE_CLAUDE_LOG    file that receives the working directory and argv, NUL-separated
#   FAKE_CLAUDE_MODE   untrusted | broken-json | fail | hang | old-help | no-id | refuse | stop-fail | rm-refused | print-fail | print-empty (default: normal)
set -u
here="$(cd "$(dirname "$0")" && pwd)"

if [ -n "${FAKE_CLAUDE_LOG:-}" ]; then
    printf '%s\0' "$PWD" "$@" >> "$FAKE_CLAUDE_LOG"
fi

mode="${FAKE_CLAUDE_MODE:-normal}"
if [ "$mode" = "hang" ]; then
    exec sleep 30
fi

case "${1:-}" in
    --version)
        echo "2.1.294 (Claude Code)"
        ;;
    agents)
        case "$mode" in
            fail) echo "daemon unavailable" >&2; exit 3 ;;
            broken-json) echo "{not json" ;;
            *) cat "$here/agents-all.json" ;;
        esac
        ;;
    stop)
        if [ "$mode" = "stop-fail" ]; then
            echo "No background session matches ${2:-}" >&2
            exit 1
        fi
        echo "stopped ${2:-}"
        ;;
    rm)
        # "stopped <id>" and "removed <id>" are what the real CLI printed on 2.1.294. So is the
        # shape of the refusal: on stdout, exit 1, with the exact flag and value to pass.
        if [ "$mode" = "rm-refused" ] && [ "${3:-}" != "--discard-unpushed" ]; then
            printf 'kept %s \xe2\x80\x94 its worktree is still at \xe2\x80\x9c/repo/.claude/worktrees/fix-login\xe2\x80\x9d\n' "${2:-}"
            printf '  2 unpushed commits on \xe2\x80\x9cworktree-fix-login\xe2\x80\x9d: 1a2b3c4 \xe2\x80\x9cFix login\xe2\x80\x9d and 1 more. They exist on no remote, so deleting the worktree would lose them.\n'
            printf "  push them and run 'claude rm %s' again, or discard the worktree and its commits: claude rm %s --discard-unpushed 1a2b3c4@wt-9\n" "${2:-}" "${2:-}"
            exit 1
        fi
        echo "removed ${2:-}"
        ;;
    --help)
        if [ "$mode" = "old-help" ]; then cat "$here/claude-help-old.txt"; else cat "$here/claude-help.txt"; fi
        ;;
    --print)
        # Stands in for a summary. It refuses any call that could change the session or run a
        # tool, the way a test of the contract should: a fork, nothing saved, no tools.
        fork=""; unsaved=""; notools=""; resume=""; model=""; prompt=""; previous=""; ended=""
        for argument in "$@"; do
            if [ -n "$ended" ]; then prompt="$argument"; continue; fi
            case "$argument" in
                --) ended=1 ;;
                --fork-session) fork=1 ;;
                --no-session-persistence) unsaved=1 ;;
            esac
            if [ "$previous" = "--tools" ] && [ -z "$argument" ]; then notools=1; fi
            if [ "$previous" = "--resume" ]; then resume="$argument"; fi
            if [ "$previous" = "--model" ]; then model="$argument"; fi
            previous="$argument"
        done
        if [ -z "$fork" ] || [ -z "$unsaved" ] || [ -z "$notools" ] || [ -z "$resume" ] || [ -z "$model" ] || [ -z "$prompt" ]; then
            echo "fake-claude: an unsafe or incomplete summary call: $*" >&2
            exit 64
        fi
        if [ "$mode" = "print-fail" ]; then
            echo "No conversation found with session ID: $resume" >&2
            exit 1
        fi
        if [ "$mode" = "print-empty" ]; then exit 0; fi
        printf '\033[2mDoing:\033[22m renaming the config file across the project.\n'
        printf 'Stopped at: waiting for a yes to delete the old file.\n'
        printf 'Worth keeping: nothing. (%s, %s)\n' "$model" "$resume"
        ;;
    --bg)
        if [ "$mode" = "untrusted" ]; then
            echo "Workspace not trusted. Run \`claude\` in $PWD once and accept the trust prompt, then retry." >&2
            exit 1
        fi
        if [ "$mode" = "refuse" ]; then
            echo "error: unknown option '--model'" >&2
            exit 1
        fi
        if [ "$mode" = "no-id" ]; then
            echo "started something"
            exit 0
        fi
        # The name given with --name, else what Claude Code would make up.
        name="probe"
        previous=""
        for argument in "$@"; do
            if [ "$argument" = "--" ]; then break; fi
            if [ "$previous" = "--name" ] || [ "$previous" = "-n" ]; then name="$argument"; fi
            previous="$argument"
        done
        # Observed on 2.1.294: coloured even though stdout is not a terminal.
        printf 'backgrounded \xc2\xb7 \033[36m4cb41c2a\033[39m \xc2\xb7 %s\n' "$name"
        printf '\033[2m  claude agents             list sessions\033[22m\n'
        ;;
    *)
        echo "fake-claude: unsupported arguments: $*" >&2
        exit 64
        ;;
esac
